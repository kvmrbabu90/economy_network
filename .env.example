# EconGraph environment configuration
# Copy this file to .env and edit before starting the server.
# .env is gitignored; this file is the canonical reference.

# ---------------------------------------------------------------------------
# LLM Provider — choose "claude" or "ollama"
# ---------------------------------------------------------------------------

# "claude" (default): uses the Claude Code CLI subprocess
#   Requires: `claude` CLI installed and authenticated (claude.ai/download)
#   Bills against your Claude Max plan — no extra API charges.
#
# "ollama": uses a local Ollama server
#   Requires: Ollama running + model pulled (ollama pull gemma4:26b)
#   Morning brief headlines will be unavailable in Ollama mode.
IMPACT_LLM_PROVIDER=claude

# Ollama server URL (only used when IMPACT_LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434/api/generate

# Ollama model name (only used when IMPACT_LLM_PROVIDER=ollama)
# Any model that follows instructions well works. Tested with gemma4:26b.
# Smaller alternatives: gemma3:12b, llama3.1:8b (lower quality)
ECONGRAPH_LLM_MODEL=gemma4:26b

# ---------------------------------------------------------------------------
# Optional: path to the Claude CLI binary
# Set this if `claude` is not on your PATH or you have multiple versions.
# ---------------------------------------------------------------------------
# CLAUDE_CLI=/home/user/.local/bin/claude

# ---------------------------------------------------------------------------
# Impact engine tuning (optional — defaults are good for most machines)
# ---------------------------------------------------------------------------

# Max BFS hops for impact propagation (default: 3)
# IMPACT_MAX_HOPS=3

# Max candidates per LLM call (default: 24)
# IMPACT_MAX_RING=24

# Concurrent LLM subprocesses per ring (default: 8)
# Reduce to 2-4 on machines with <16 GB RAM or slow Ollama inference.
# IMPACT_RING_PARALLELISM=8

# LLM call timeout in seconds (default: 100)
# IMPACT_LLM_TIMEOUT=100
