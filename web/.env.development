# Local-dev override for the API base URL. Vite injects VITE_* variables at
# build time. Commit-clean: this file is checked in but the *value* should be
# left at the documented default unless you're actively shimming around a
# port conflict (in which case revert before committing). The published run
# command in the README assumes port 8001.
VITE_API_BASE_URL=http://localhost:8001
